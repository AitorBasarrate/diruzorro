# Diruzorro - Configuración
# Copia este fichero a .env y rellena los valores

# Puerto del servidor
PORT=8080

# Ruta de la base de datos SQLite
DATABASE_PATH=/data/diruzorro.db

# API Key para autenticación (genera una aleatoria)
# Ejemplo: openssl rand -hex 32
API_KEY=

# GoCardless Bank Account Data (ex-Nordigen)
# Regístrate en https://bankaccountdata.gocardless.com/
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
